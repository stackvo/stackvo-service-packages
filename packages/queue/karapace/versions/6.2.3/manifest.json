{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "karapace",
  "version": "6.2.3",
  "image": {
    "registry": "ghcr.io",
    "repository": "aiven-open/karapace",
    "tag": "6.2.3"
  },
  "capabilities": ["schema-registry"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "main", "container": 8081, "preferred": 8081, "protocol": "tcp", "legacyKey": "SERVICE_KARAPACE_HOST_PORT", "primary": true }
  ],
  "volumes": [
  ],
  "files": [
  ],
  "settings": [
    { "key": "BOOTSTRAP_SERVERS", "type": "string", "default": "stackvo-kafka:9092", "label": { "en": "Kafka bootstrap address (the Kafka instance's workspace alias)" } },
    { "key": "TOPIC_NAME", "type": "string", "default": "_schemas", "label": { "en": "Kafka topic the registry stores its schemas in" } },
    { "key": "COMPATIBILITY", "type": "enum", "default": "BACKWARD", "options": ["NONE", "BACKWARD", "BACKWARD_TRANSITIVE", "FORWARD", "FORWARD_TRANSITIVE", "FULL", "FULL_TRANSITIVE"], "label": { "en": "Default compatibility level" } }
  ],
  "connection": { "scheme": "http", "port": "main" },
  "url": null,
  "dependsOn": [
    { "capability": "queue", "service": "kafka", "required": true }
  ],
  "health": { "test": ["CMD-SHELL", "curl -fsS -o /dev/null http://127.0.0.1:8081/_health"], "interval": "15s", "retries": 12, "startPeriod": "45s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "4acd73784cada4ece1bd4d981af4b9485e1f18508b0f400dd49a0164d60a45c0" },
  "support": { "status": "supported" }
}
