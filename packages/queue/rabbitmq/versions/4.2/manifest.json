{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "rabbitmq",
  "version": "4.2",
  "image": {
    "repository": "rabbitmq",
    "tag": "4.2-management"
  },
  "capabilities": ["queue", "amqp"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "main", "container": 5672, "preferred": 5672, "protocol": "tcp", "legacyKey": "HOST_PORT_RABBITMQ", "primary": true },
    { "name": "mgmt", "container": 15672, "preferred": 15672, "protocol": "tcp", "legacyKey": "HOST_PORT_RABBITMQ_MGMT", "primary": false }
  ],
  "volumes": [
    { "name": "data", "container": "/var/lib/rabbitmq", "purgeable": true },
    { "name": "logs", "container": "/var/log/rabbitmq", "purgeable": true }
  ],
  "files": [
  ],
  "settings": [
    { "key": "DEFAULT_USER", "type": "string", "default": "admin" },
    { "key": "DEFAULT_PASS", "type": "secret", "default": "admin" }
  ],
  "connection": {
    "scheme": "amqp",
    "port": "main",
    "userSetting": "DEFAULT_USER",
    "defaultUser": "guest",
    "passwordSetting": "DEFAULT_PASS"
  },
  "url": { "subdomain": "rabbitmq", "port": "mgmt" },
  "dependsOn": [],
  "health": { "test": ["CMD", "rabbitmq-diagnostics", "-q", "ping"], "interval": "15s", "retries": 12, "startPeriod": "40s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "309a17c2d940d5c1893b94dfd6b325ce9e0bc9b2382b15eef7ce8cfe4fb5d33f" },
  "support": {"eolDate":"2026-07-31","source":"https://endoflife.date/api/rabbitmq.json","status":"eol"}
}
