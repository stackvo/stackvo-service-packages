{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "grafana",
  "version": "11.6",
  "image": {
    "repository": "grafana/grafana",
    "tag": "11.6"
  },
  "capabilities": ["dashboard"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "main", "container": 3000, "preferred": 3001, "protocol": "tcp", "legacyKey": "HOST_PORT_GRAFANA", "primary": false }
  ],
  "volumes": [
    { "name": "data", "container": "/var/lib/grafana", "purgeable": true },
    { "name": "config", "container": "/etc/grafana", "purgeable": true }
  ],
  "files": [
  ],
  "settings": [
    { "key": "ADMIN_USER", "type": "string", "default": "admin" },
    { "key": "ADMIN_PASSWORD", "type": "secret", "default": "admin" },
    { "key": "DEFAULT_TLD_SUFFIX", "type": "string", "default": "loc" },
    { "key": "HOST_UID", "type": "string", "default": "472" }
  ],
  "connection": null,
  "url": { "subdomain": "grafana", "port": "main" },
  "dependsOn": [],
  "health": { "test": ["CMD-SHELL", "curl -fsS -o /dev/null http://127.0.0.1:3000/api/health"], "interval": "10s", "retries": 12, "startPeriod": "20s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "94f7612e24d1899813eaa7d39f125c211948b90c20d767b1311e6da06de70fd8" },
  "support": {"eolDate":"2026-06-25","source":"https://endoflife.date/api/grafana.json","status":"eol"}
}
