  "connection": {
    "scheme": "http",
    "port": "main"
  },
  "url": null,
  "dependsOn": [],
  "health": null,
  "compose": {
    "file": "compose.yml.tpl",
    "sha256": "a0d0a76a0c042bdadc750830b70f6f36f3f72ff572a15f86a888366abbb41afb"
