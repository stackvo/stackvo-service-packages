{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "kafbat",
  "version": "v1.5.0",
  "image": {
    "repository": "kafbat/kafka-ui",
    "tag": "v1.5.0"
  },
  "capabilities": ["admin-ui"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "main", "container": 8080, "preferred": 8080, "protocol": "tcp", "legacyKey": "SERVICE_KAFBAT_HOST_PORT", "primary": false }
  ],
  "volumes": [
  ],
  "files": [
  ],
  "settings": [
    { "key": "DYNAMIC_CONFIG", "type": "string", "default": "true" },
    { "key": "CLUSTER_NAME", "type": "string", "default": "stackvo-kafka" },
    { "key": "BOOTSTRAP_SERVERS", "type": "string", "default": "stackvo-kafka:9092" }
  ],
  "connection": null,
  "url": { "subdomain": "kafbat", "port": "main" },
  "dependsOn": [
    { "capability": "queue", "service": "kafka", "required": true }
  ],
  "health": { "test": ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8080/actuator/health"], "interval": "15s", "retries": 15, "startPeriod": "40s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "39dbc09b0dc042663fe5bc53fb28108cea1176b0d47b07a46ec52aff8a420761" },
  "support": {"status":"supported"}
}
