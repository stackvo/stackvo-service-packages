{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "pgadmin",
  "version": "9.16",
  "image": {
    "repository": "dpage/pgadmin4",
    "tag": "9.16"
  },
  "capabilities": ["admin-ui"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "main", "container": 80, "preferred": 5050, "protocol": "tcp", "legacyKey": "SERVICE_PGADMIN_HOST_PORT", "primary": false }
  ],
  "volumes": [
    { "name": "data", "container": "/var/lib/pgadmin", "purgeable": true }
  ],
  "files": [
  ],
  "settings": [
    { "key": "DEFAULT_EMAIL", "type": "string", "default": "admin@stackvo.loc" },
    { "key": "DEFAULT_PASSWORD", "type": "secret", "default": "admin" },
    { "key": "SERVER_MODE", "type": "string", "default": "False" },
    { "key": "MASTER_PASSWORD_REQUIRED", "type": "string", "default": "False" }
  ],
  "connection": null,
  "url": { "subdomain": "pgadmin", "port": "main" },
  "dependsOn": [
    { "capability": "postgres-protocol", "required": false }
  ],
  "health": { "test": ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:80/misc/ping"], "interval": "15s", "retries": 12, "startPeriod": "30s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "a623c99076a548a9dcdd34acb0e9ecaa912db7d3897ca3533df81de6007ee90b" },
  "support": {"status":"supported"}
}
