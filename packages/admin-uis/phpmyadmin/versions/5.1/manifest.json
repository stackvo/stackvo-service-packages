{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "phpmyadmin",
  "version": "5.1",
  "image": {
    "repository": "phpmyadmin",
    "tag": "5.1"
  },
  "capabilities": ["admin-ui"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "main", "container": 80, "preferred": 8081, "protocol": "tcp", "legacyKey": "SERVICE_PHPMYADMIN_HOST_PORT", "primary": false }
  ],
  "volumes": [
  ],
  "files": [
  ],
  "settings": [
    { "key": "ARBITRARY", "type": "string", "default": "1" },
    { "key": "HOST", "type": "string", "default": "stackvo-mysql" },
    { "key": "PORT", "type": "string", "default": "3306" },
    { "key": "UPLOAD_LIMIT", "type": "string", "default": "300M" }
  ],
  "connection": null,
  "url": { "subdomain": "phpmyadmin", "port": "main" },
  "dependsOn": [
    { "capability": "mysql-protocol", "required": false }
  ],
  "health": { "test": ["CMD-SHELL", "curl -fsS -o /dev/null http://127.0.0.1:80/"], "interval": "15s", "retries": 8, "startPeriod": "15s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "350a48695540759a85d794dd637011f95ba1d28ca03b8e6034348c860f8912eb" },
  "support": {"status":"supported"}
}
