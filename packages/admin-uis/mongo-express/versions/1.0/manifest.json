{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "mongo-express",
  "version": "1.0",
  "image": {
    "repository": "mongo-express",
    "tag": "1.0"
  },
  "capabilities": ["admin-ui"],
  "instancing": { "multiple": false, "identity": "version" },
  "ports": [
    { "name": "main", "container": 8081, "preferred": 8083, "protocol": "tcp", "primary": false }
  ],
  "volumes": [
  ],
  "files": [
  ],
  "settings": [
    { "key": "MONGODB_SERVER", "type": "string", "default": "stackvo-mongo" },
    { "key": "MONGODB_PORT", "type": "string", "default": "27017" },
    { "key": "ADMIN_USERNAME", "type": "string", "default": "root" },
    { "key": "ADMIN_PASSWORD", "type": "secret", "default": "root" },
    { "key": "BASICAUTH_USERNAME", "type": "string", "default": "admin" },
    { "key": "BASICAUTH_PASSWORD", "type": "secret", "default": "admin" },
    { "key": "BASEURL", "type": "string", "default": "/" }
  ],
  "connection": null,
  "url": { "subdomain": "mongo-express", "port": "main" },
  "dependsOn": [
    { "capability": "document-store", "service": "mongo", "required": true }
  ],
  "compose": { "file": "compose.yml.tpl", "sha256": "4c327878cd46ace56cac397c2b0901ade47566d7dd454537370eef35050218dc" },
  "support": { "status": "supported" }
