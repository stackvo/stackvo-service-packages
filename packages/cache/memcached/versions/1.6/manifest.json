{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "memcached",
  "version": "1.6",
  "image": {
    "repository": "memcached",
    "tag": "1.6"
  },
  "capabilities": ["cache"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "main", "container": 11211, "preferred": 11211, "protocol": "tcp", "legacyKey": "HOST_PORT_MEMCACHED", "primary": true }
  ],
  "volumes": [
  ],
  "files": [
  ],
  "settings": [
    { "key": "MEMORY", "type": "string", "default": "256" },
    { "key": "CONNECTIONS", "type": "string", "default": "1024" },
    { "key": "THREADS", "type": "string", "default": "4" },
    { "key": "EXTRA_ARGS", "type": "string", "default": "" }
  ],
  "connection": {
    "scheme": "host-port",
    "port": "main"
  },
  "url": null,
  "dependsOn": [],
  "health": { "test": ["CMD-SHELL", "timeout 2 bash -c '</dev/tcp/127.0.0.1/11211'"], "interval": "10s", "retries": 10, "startPeriod": "5s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "3439aa75c8ccffdc0cb00673f1b0a4e9bdc137994df26b78bc03b0723a1955fb" },
  "support": {"status":"supported"}
}
