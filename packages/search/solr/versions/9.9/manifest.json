{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "solr",
  "version": "9.9",
  "image": {
    "repository": "solr",
    "tag": "9.9"
  },
  "capabilities": ["search"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "main", "container": 8983, "preferred": 8983, "protocol": "tcp", "legacyKey": "SERVICE_SOLR_HOST_PORT", "primary": true }
  ],
  "volumes": [
    { "name": "data", "container": "/var/solr", "purgeable": true }
  ],
  "files": [
  ],
  "settings": [
    { "key": "CORE", "type": "string", "default": "stackvo" },
    { "key": "SOLR_HEAP", "type": "string", "default": "512m" }
  ],
  "connection": {
    "scheme": "http",
    "port": "main"
  },
  "url": { "subdomain": "solr", "port": "main" },
  "dependsOn": [],
  "health": { "test": ["CMD-SHELL", "curl -fsS -o /dev/null http://127.0.0.1:8983/solr/admin/info/system"], "interval": "10s", "retries": 15, "startPeriod": "30s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "24954d88e1ab028f9e6ab13a2acf9a5a4edd2b33feda0d1222f64d0bef30c0d4" },
  "support": {"status":"supported"}
}
