{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "kibana",
  "version": "9.3.8",
  "image": {
    "repository": "kibana",
    "tag": "9.3.8"
  },
  "capabilities": ["dashboard"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "main", "container": 5601, "preferred": 5601, "protocol": "tcp", "legacyKey": "HOST_PORT_KIBANA", "primary": false }
  ],
  "volumes": [
    { "name": "data", "container": "/usr/share/kibana/data", "purgeable": true }
  ],
  "files": [
  ],
  "settings": [
    { "key": "ELASTICSEARCH_HOSTS", "type": "string", "default": "http://stackvo-elasticsearch:9200" },
    { "key": "SERVER_NAME", "type": "string", "default": "stackvo-kibana" },
    { "key": "SERVER_HOST", "type": "string", "default": "0.0.0.0" }
  ],
  "connection": null,
  "url": { "subdomain": "kibana", "port": "main" },
  "dependsOn": [
    { "capability": "search", "service": "elasticsearch", "required": true }
  ],
  "health": { "test": ["CMD-SHELL", "curl -fsS -o /dev/null http://127.0.0.1:5601/api/status"], "interval": "15s", "retries": 20, "startPeriod": "60s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "dd3c0a89b7bcf0a9dc3b8cc9b1378635a6bb096d17e0dac59de2382be0cf265c" },
  "support": {"status":"supported"}
}
