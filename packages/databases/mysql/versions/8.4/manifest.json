{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "mysql",
  "version": "8.4",
  "image": {
    "repository": "mysql",
    "tag": "8.4"
  },
  "capabilities": ["sql", "mysql-protocol"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "main", "container": 3306, "preferred": 3306, "protocol": "tcp", "legacyKey": "HOST_PORT_MYSQL", "primary": true }
  ],
  "volumes": [
    { "name": "data", "container": "/var/lib/mysql", "purgeable": true }
  ],
  "files": [
    { "name": "mysql_cnf", "template": "files/my.cnf.tpl", "target": "/etc/mysql/conf.d/stackvo.cnf", "mode": "0444", "sha256": "6565417037f0f3e49cf88ef0f5edc355b23c552fa1acad9afcfa4feb3336fdf3" }
  ],
  "settings": [
    { "key": "ROOT_PASSWORD", "type": "secret", "default": "root" },
    { "key": "DATABASE", "type": "string", "default": "stackvo" }
  ],
  "connection": {
    "scheme": "mysql",
    "port": "main",
    "defaultUser": "root",
    "passwordSetting": "ROOT_PASSWORD",
    "databaseSetting": "DATABASE",
    "defaultDatabase": "stackvo"
  },
  "url": null,
  "dependsOn": [],
  "health": { "test": ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1"], "interval": "10s", "retries": 12, "startPeriod": "30s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "c0c837628aa3faff54bca020247ba64cffa328c8e0d504e5f4bfe717a9b2f5b3" },
  "support": {"eolDate":"2032-04-30","source":"https://endoflife.date/api/mysql.json","status":"supported"}
}
