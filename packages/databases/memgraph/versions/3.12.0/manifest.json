{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "memgraph",
  "version": "3.12.0",
  "image": {
    "repository": "memgraph/memgraph",
    "tag": "3.12.0"
  },
  "capabilities": [
    "graph",
    "bolt"
  ],
  "instancing": {
    "multiple": true,
    "identity": "version"
  },
  "ports": [
    {
      "name": "bolt",
      "container": 7687,
      "preferred": 7688,
      "protocol": "tcp",
      "primary": true
    }
  ],
  "volumes": [
    {
      "name": "data",
      "container": "/var/lib/memgraph",
      "purgeable": true
    }
  ],
  "files": [],
  "settings": [],
  "connection": {
    "scheme": "bolt",
    "port": "bolt"
  },
  "url": null,
  "dependsOn": [],
  "health": {
    "test": [
      "CMD-SHELL",
      "echo 'RETURN 1;' | mgconsole"
    ],
    "interval": "10s",
    "retries": 12,
    "startPeriod": "20s"
  },
  "compose": {
    "file": "compose.yml.tpl",
    "sha256": "4536d26125e57a815a076973b32cbbd3b5315927e473420c3ca17aeed66a88a2"
  },
  "support": {
    "status": "supported"
  }
}
