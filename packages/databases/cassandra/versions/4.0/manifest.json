{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "cassandra",
  "version": "4.0",
  "image": {
    "repository": "cassandra",
    "tag": "4.0"
  },
  "capabilities": ["wide-column"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "main", "container": 9042, "preferred": 9042, "protocol": "tcp", "legacyKey": "HOST_PORT_CASSANDRA", "primary": true },
    { "name": "jmx", "container": 7199, "preferred": 7199, "protocol": "tcp", "legacyKey": "HOST_PORT_CASSANDRA_JMX", "primary": false }
  ],
  "volumes": [
    { "name": "data", "container": "/var/lib/cassandra", "purgeable": true }
  ],
  "files": [
  ],
  "settings": [
    { "key": "CLUSTER_NAME", "type": "string", "default": "StackvoCluster" },
    { "key": "DC", "type": "string", "default": "dc1" },
    { "key": "RACK", "type": "string", "default": "rack1" },
    { "key": "ENDPOINT_SNITCH", "type": "string", "default": "GossipingPropertyFileSnitch" },
    { "key": "MAX_HEAP_SIZE", "type": "string", "default": "512M" },
    { "key": "HEAP_NEWSIZE", "type": "string", "default": "128M" }
  ],
  "connection": {
    "scheme": "host-port",
    "port": "main"
  },
  "url": null,
  "dependsOn": [],
  "health": { "test": ["CMD-SHELL", "cqlsh -e 'describe cluster'"], "interval": "15s", "retries": 20, "startPeriod": "90s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "de5c19135ec9aa693da58c38a81711845ca72d21aa19b257f7f520d3b2c1adff" },
  "support": {"status":"supported"}
}
