{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "nessie",
  "version": "0.107.9",
  "image": {
    "registry": "ghcr.io",
    "repository": "projectnessie/nessie",
    "tag": "0.107.9"
  },
  "capabilities": [
    "iceberg-catalog"
  ],
  "instancing": {
    "multiple": true,
    "identity": "version"
  },
  "ports": [
    {
      "name": "http",
      "container": 19120,
      "preferred": 19120,
      "protocol": "tcp",
      "primary": true
    }
  ],
  "volumes": [
    {
      "name": "data",
      "container": "/deployments/data",
      "purgeable": true
    }
  ],
  "files": [],
  "settings": [],
  "connection": {
    "scheme": "http",
    "port": "http"
  },
  "url": {
    "subdomain": "nessie",
    "port": "http"
  },
  "dependsOn": [],
  "health": {
    "test": [
      "CMD-SHELL",
      "curl -fsS -o /dev/null http://127.0.0.1:9000/q/health/ready"
    ],
    "interval": "10s",
    "retries": 15,
    "startPeriod": "20s"
  },
  "compose": {
    "file": "compose.yml.tpl",
    "sha256": "ec4361b836e46c9f5b7e976948cd5f6857589c126e08604deff5289912217884"
  },
  "support": {
    "status": "supported"
  }
}
