{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "mailhog",
  "version": "v1.0.1",
  "image": {
    "repository": "mailhog/mailhog",
    "tag": "v1.0.1"
  },
  "capabilities": ["smtp", "mail-catcher"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "smtp", "container": 1025, "preferred": 1025, "protocol": "tcp", "legacyKey": "HOST_PORT_MAILHOG_SMTP", "primary": true },
    { "name": "ui", "container": 8025, "preferred": 8025, "protocol": "tcp", "legacyKey": "HOST_PORT_MAILHOG_UI", "primary": false }
  ],
  "volumes": [
  ],
  "files": [
  ],
  "settings": [
  ],
  "connection": {
    "scheme": "smtp",
    "port": "smtp"
  },
  "url": { "subdomain": "mailhog", "port": "ui" },
  "dependsOn": [],
  "health": { "test": ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8025/api/v2/messages"], "interval": "10s", "retries": 10, "startPeriod": "5s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "be7eaa14a2c9d31ff0c22c3f591c672f2feccfa8d93ca8d7379b52eec85fc466" },
  "support": {"status":"supported"}
}
