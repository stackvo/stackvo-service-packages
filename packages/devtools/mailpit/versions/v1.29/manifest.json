{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "mailpit",
  "version": "v1.29",
  "image": {
    "repository": "axllent/mailpit",
    "tag": "v1.29"
  },
  "capabilities": ["smtp", "mail-catcher"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "smtp", "container": 1025, "preferred": 1025, "protocol": "tcp", "legacyKey": "HOST_PORT_MAILPIT_SMTP", "primary": true },
    { "name": "ui", "container": 8025, "preferred": 8025, "protocol": "tcp", "legacyKey": "HOST_PORT_MAILPIT_UI", "primary": false }
  ],
  "volumes": [
    { "name": "data", "container": "/data", "purgeable": true }
  ],
  "files": [
  ],
  "settings": [
  ],
  "connection": {
    "scheme": "smtp",
    "port": "smtp"
  },
  "url": { "subdomain": "mailpit", "port": "ui" },
  "dependsOn": [],
  "health": { "test": ["CMD", "/mailpit", "readyz"], "interval": "10s", "retries": 10, "startPeriod": "5s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "28a3c7272fc5edb7c38cd337327aeced007c20cf041d04a5069150f1ca89a3db" },
  "support": {"status":"supported"}
}
