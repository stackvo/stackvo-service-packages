{
  "apiVersion": "stackvo.dev/package/v1",
  "service": "icecast",
  "version": "2.5.0",
  "image": {
    "repository": "libretime/icecast",
    "tag": "2.5.0"
  },
  "capabilities": ["streaming"],
  "instancing": { "multiple": true, "identity": "version" },
  "ports": [
    { "name": "main", "container": 8000, "preferred": 8000, "protocol": "tcp", "legacyKey": "SERVICE_ICECAST_HOST_PORT", "primary": true }
  ],
  "volumes": [
  ],
  "files": [
  ],
  "settings": [
    { "key": "SOURCE_PASSWORD", "type": "secret", "default": "stackvo-source" },
    { "key": "RELAY_PASSWORD", "type": "secret", "default": "stackvo-relay" },
    { "key": "ADMIN_USERNAME", "type": "string", "default": "admin" },
    { "key": "ADMIN_PASSWORD", "type": "secret", "default": "stackvo-admin" },
    { "key": "HOSTNAME", "type": "string", "default": "localhost", "label": { "en": "Hostname listeners use to reach this server" } },
    { "key": "MAX_CLIENTS", "type": "int", "default": 100 },
    { "key": "MAX_SOURCES", "type": "int", "default": 2 }
  ],
  "connection": {
    "scheme": "http",
    "port": "main"
  },
  "url": { "subdomain": "icecast", "port": "main" },
  "dependsOn": [],
  "health": { "test": ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8000 && printf 'GET /status-json.xsl HTTP/1.0\\r\\n\\r\\n' >&3 && head -n1 <&3 | grep -q ' 200 '"], "interval": "10s", "retries": 10, "startPeriod": "5s" },
  "compose": { "file": "compose.yml.tpl", "sha256": "47515757d57a3d65cea5b704abd4713045564d16ed9382c95fb53f0e139a7ae8" },
  "support": {"status":"supported"}
}
